# DCS Document Platform - copy to `.env` (never commit `.env`). PLACEHOLDERS ONLY.
# The API validates every variable at startup (src/config/envSchema.ts) and refuses to start, without
# printing values, if one is missing or weak. See docs/architecture/env.example for the full future list.

# ---- Server ----
NODE_ENV=development                 # development | production | test
API_HOST=127.0.0.1
API_PORT=4800
APP_PUBLIC_URL=                      # exact public https origin of the web app (required to be https in production)
TRUST_PROXY=0                        # reverse-proxy hops in front of the API; set 1 behind Nginx so rate limits see real IPs
APP_TIMEZONE=Asia/Kolkata
REQUEST_BODY_LIMIT_KB=100            # JSON bodies only; file uploads use their own limit

# ---- Database (PostgreSQL 14+) ----
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/dcs_docs
# Tests use ONLY this database; its name must end in _test. The test run empties it.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@127.0.0.1:5432/dcs_docs_test

# ---- CORS / headers ----
CORS_ORIGIN=http://127.0.0.1:5173    # comma-separated bare origins; "*" refused; https required in production
CSP_REPORT_URI=

# ---- CSRF / cookies ----
CSRF_SECRET=change-me-generate-with-openssl-rand-base64-48   # >= 32 chars; a placeholder is refused in production
COOKIE_SECURE=                       # empty = true in production, false otherwise; false is refused in production

# ---- Authentication (email + password, JWT access token, rotating refresh token) ----
ALLOWED_EMAIL_DOMAIN=decirclesolar.com
BCRYPT_COST=12                       # 4-15; at least 12 is required in production
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48   # >= 32 chars, different from CSRF_SECRET; placeholder refused in production
ACCESS_TOKEN_TTL=10m                 # at most 60m
REFRESH_TOKEN_IDLE_TIMEOUT_MINUTES=480
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
REFRESH_COOKIE_NAME=dcs_docs_refresh
REAUTH_MAX_AGE_SECONDS=300           # sensitive actions need a password check newer than this

# ---- First SUPER_ADMIN (only used by `npm run bootstrap:admin`; it prompts for the password when unset) ----
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PASSWORD=           # optional, non-interactive provisioning only; remove after use

# ---- Storage (local disk now; switch to OCI / S3 / MinIO by changing this block only) ----
STORAGE_DRIVER=local                 # local | oci | s3
STORAGE_LOCAL_ROOT=/var/lib/dcs-docs/storage          # absolute path OUTSIDE the repo; created 0700. Required when STORAGE_DRIVER=local
STORAGE_QUARANTINE_ROOT=/var/lib/dcs-docs/quarantine  # separate from the clean root. Required when STORAGE_DRIVER=local
STORAGE_MAX_FILE_SIZE_MB=25          # 1-100
STORAGE_ALLOWED_MIME_TYPES=application/pdf   # only PDF is accepted in this version
# Oracle Cloud Object Storage via its S3-compatible API (required when STORAGE_DRIVER=oci)
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET_NAME=
OCI_S3_ENDPOINT=                     # https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
# Generic S3 or MinIO (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---- File encryption (AES-256-GCM envelope; required, no default) ----
FILE_ENCRYPTION_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY   # generate: openssl rand -base64 32 ; move to KMS/Vault in production
FILE_ENCRYPTION_KEY_ID=v1
FILE_ENCRYPTION_PREVIOUS_KEYS=       # only during rotation: v0=<base64>;...

# ---- Malware scanning and PDF inspection ----
MALWARE_SCAN_ENABLED=true            # false is refused in production
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
PDF_ACTIVE_CONTENT_POLICY=block      # block | flag (JavaScript, Launch, embedded files, OpenAction)

# ---- Email (Gmail API, per-user OAuth with scope gmail.send only; separate from login) ----
GMAIL_OAUTH_CLIENT_ID=               # set all three together; leave empty until the Workspace admin has created the OAuth client
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=            # https://<public-host>/api/v1/email/connection/callback
EMAIL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY   # encrypts Gmail refresh tokens; must differ from the file key
EMAIL_MAX_ATTACHMENT_TOTAL_MB=20     # 1-35 (Gmail limit)

# ---- Background jobs ----
JOBS_ENABLED=true
JOBS_MAX_ATTEMPTS=8
JOBS_LEASE_MS=60000
JOBS_POLL_INTERVAL_MS=2000

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_API_MAX_PER_IP=600
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_REFRESH_MAX=120
RATE_LIMIT_UPLOAD_MAX_PER_HOUR=30
RATE_LIMIT_DOWNLOAD_MAX_PER_HOUR=100
RATE_LIMIT_SEND_MAX_PER_HOUR=50

# ---- Logging ----
LOG_LEVEL=info                       # error | warn | info | debug
