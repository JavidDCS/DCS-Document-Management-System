# DCS Documents: copy to `.env` (never commit `.env`). PLACEHOLDERS ONLY.
# Only the variables you must set are listed. Everything else has a safe default (see packages/api/src/config/envSchema.ts).
# The API refuses to start, without printing values, if a variable here is missing or weak.

# ---- Database (PostgreSQL 14+) ----
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/dcs_docs
# Tests only (the database name must end in _test; the test run empties it):
DATABASE_URL_TEST=postgresql://USER:PASSWORD@127.0.0.1:5432/dcs_docs_test

# ---- Secrets: generate each with `openssl rand -base64 48` (the two keys below with `openssl rand -base64 32`) ----
CSRF_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
FILE_ENCRYPTION_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY    # encrypts every stored file; keep an offline copy, losing it makes files unrecoverable
EMAIL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY    # must differ from the file key

# ---- Files (absolute paths outside the repository; created with mode 0700) ----
STORAGE_LOCAL_ROOT=/var/lib/dcs-docs/storage
STORAGE_QUARANTINE_ROOT=/var/lib/dcs-docs/quarantine

# ---- Ports and hosts (the API, the web dev server and CORS all read these; nothing is hardcoded) ----
API_HOST=127.0.0.1
API_PORT=7800
WEB_HOST=127.0.0.1
WEB_PORT=7801

# ---- Company ----
ALLOWED_EMAIL_DOMAIN=decirclesolar.com

# ---- Development only ----
MALWARE_SCAN_ENABLED=false           # default is true (ClamAV on 127.0.0.1:3310); false is refused in production

# ---- Production: also set these on the server ----
# NODE_ENV=production
# APP_PUBLIC_URL=https://docs.example.com # the public https address; CORS and the Gmail callback URL are derived from it
# TRUST_PROXY=1                           # one reverse proxy (nginx) in front
#
# ---- Optional (defaults are fine; add only to change) ----
# LOG_LEVEL, RATE_LIMIT_*, JOBS_*, CLAMAV_HOST/PORT, PDF_ACTIVE_CONTENT_POLICY,
# STORAGE_DRIVER=oci|s3 with OCI_* / S3_* (object storage later), GMAIL_OAUTH_* (when Gmail sending is enabled),
# SEED_SUPER_ADMIN_EMAIL / SEED_SUPER_ADMIN_NAME (only for `npm run bootstrap:admin`; the password is typed at a hidden prompt)
