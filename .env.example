# ==============================================================================
# DCS Document Management & Distribution Platform - Environment Configuration
# ==============================================================================
# Copy this file to `.env` (never commit `.env` to git).
#
# Sections below clearly distinguish between:
#   1. MANDATORY CORE REQUIREMENTS  --> The API and Web app refuse to start without these.
#   2. GOOGLE OAUTH: LOGIN (SSO)     --> Google Workspace sign-in via OIDC.
#   3. GOOGLE OAUTH: GMAIL DISPATCH  --> Sending documents from individual user mailboxes.
#   4. PRODUCTION & OPTIONAL         --> Settings for live server deployment and tests.
# ==============================================================================


# ==============================================================================
# 1. MANDATORY CORE REQUIREMENTS (The app WILL NOT RUN without these)
# ==============================================================================

# ---- Database (PostgreSQL 14+) ----
# Must be a valid PostgreSQL connection string. The database must exist and user must have full schema rights.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/dcs_docs

# ---- Secrets (Cryptographic Keys) ----
# CSRF and JWT secrets: Generate high-entropy keys with `openssl rand -base64 48` (minimum 32 characters).
CSRF_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_openssl_rand_base64_48
JWT_ACCESS_SECRET=REPLACE_WITH_MIN_32_CHAR_SECRET_openssl_rand_base64_48

# Envelope encryption master key: Encrypts every stored file at rest.
# Must be EXACTLY 32 random bytes, base64 encoded. Generate with: `openssl rand -base64 32`
# WARNING: Keep a secure offline backup! Losing this key makes all stored files unrecoverable.
FILE_ENCRYPTION_MASTER_KEY=REPLACE_WITH_EXACTLY_32_BYTE_BASE64_KEY

# Email token encryption key: Encrypts user OAuth refresh tokens at rest.
# Must be EXACTLY 32 random bytes, base64 encoded, and MUST DIFFER from the file encryption key.
EMAIL_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_32_BYTE_BASE64_KEY

# ---- Storage Directories (Local disk driver) ----
# Absolute paths outside the git repository; created with strict permissions.
# On Linux: e.g. /var/lib/dcs-docs/storage and /var/lib/dcs-docs/quarantine (chmod 0700).
# On Windows: e.g. D:/DCS-Docs-Data/storage and D:/DCS-Docs-Data/quarantine.
STORAGE_LOCAL_ROOT=/var/lib/dcs-docs/storage
STORAGE_QUARANTINE_ROOT=/var/lib/dcs-docs/quarantine

# ---- Network Ports and Hosts ----
# The API, Vite web server, and CORS all read these dynamically.
API_HOST=127.0.0.1
API_PORT=7800
WEB_HOST=127.0.0.1
WEB_PORT=7801

# ---- Organization & Branding ----
# Organization / Company display name used across UI headers, page titles, and outbound document emails.
APP_COMPANY_NAME=DeCircle Solar

# ---- Company Domain ----
# Only emails belonging to this organization domain are permitted to register or sign in.
ALLOWED_EMAIL_DOMAIN=decirclesolar.com

# ---- Malware Scanning Policy ----
# Set to `false` for offline local development without ClamAV.
# Must be set to `true` on production servers (connects to ClamAV daemon on 127.0.0.1:3310).
MALWARE_SCAN_ENABLED=false


# ==============================================================================
# 2. GOOGLE OAUTH: WORKSPACE SIGN-IN (OIDC Single Sign-On Login)
# ==============================================================================
# Allows employees to sign in to the DCS Portal using their Google Workspace account.
# 1. In Google Cloud Console (APIs & Services > Credentials), create an OAuth 2.0 Web Application client.
# 2. Add Authorized Redirect URI: http://127.0.0.1:7801/api/v1/auth/google/callback
#    (In production: https://<APP_PUBLIC_URL>/api/v1/auth/google/callback)
# 3. Enable AUTH_GOOGLE_LOGIN_ENABLED=true and paste the Client ID and Secret below.

# Enables or disables the "Sign in with Google" button on the login screen (default: false)
AUTH_GOOGLE_LOGIN_ENABLED=false

# Allows standard email + password login alongside Google sign-in (default: true).
# Set to false to require Google Workspace login exclusively.
AUTH_PASSWORD_LOGIN_ENABLED=true

# Google OAuth 2.0 Web Client credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: explicitly override the callback URI. Defaults to <WEB origin>/api/v1/auth/google/callback
# GOOGLE_REDIRECT_URI=http://127.0.0.1:7801/api/v1/auth/google/callback


# ==============================================================================
# 3. GOOGLE OAUTH: GMAIL DISPATCH (Sending Documents via User Mailbox)
# ==============================================================================
# Allows users to link their corporate Gmail account to send documents (NDAs, contracts)
# directly from their own mailbox. Uses strictly the scoped `gmail.send` permission.
# 1. In Google Cloud Console, enable the Gmail API.
# 2. Create an OAuth 2.0 Client ID for Web Applications.
# 3. Add Authorized Redirect URI: http://127.0.0.1:7801/api/v1/email/connection/callback
#    (In production: https://<APP_PUBLIC_URL>/api/v1/email/connection/callback)
# Note: You can reuse the same Client ID / Secret as above if both redirect URIs are registered.

GMAIL_OAUTH_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-gmail-client-secret

# Optional: explicitly override redirect URI. Defaults to <WEB origin>/api/v1/email/connection/callback
# GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:7801/api/v1/email/connection/callback


# ==============================================================================
# 4. OPTIONAL, TESTING & PRODUCTION SETTINGS
# ==============================================================================

# Database used exclusively for automated test suites (vitest). The name MUST end in `_test`.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@127.0.0.1:5432/dcs_docs_test

# Initial Super Administrator bootstrap credentials (used by: npm run bootstrap:admin -w packages/api)
SEED_SUPER_ADMIN_EMAIL=admin@decirclesolar.com
SEED_SUPER_ADMIN_NAME=Administrator
# SEED_SUPER_ADMIN_PASSWORD=SecurePassword#2026 (only for non-interactive setup; remove afterwards)

# ---- Production Server Deployment Settings ----
# NODE_ENV=production
# APP_PUBLIC_URL=https://docs.decirclesolar.com # Public HTTPS URL; CORS and OAuth callbacks derive from it
# TRUST_PROXY=1                                 # Number of reverse proxies (Nginx/ALB) in front
# CORS_ORIGIN=https://docs.decirclesolar.com    # Explicit allowed web origins (no wildcard * in prod)
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# LOG_LEVEL=info
