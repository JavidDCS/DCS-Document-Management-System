{
  "name": "@dcs-docs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc -b ../shared && tsx watch src/index.ts",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b ../shared && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "tsx prisma/runPrisma.ts generate",
    "prisma:validate": "tsx prisma/runPrisma.ts validate",
    "prisma:status": "tsx prisma/runPrisma.ts migrate status",
    "prisma:deploy": "tsx prisma/runPrisma.ts migrate deploy",
    "audit:verify": "tsx scripts/verifyAudit.ts",
    "test": "vitest run",
    "check": "tsx ../../scripts/doctor.ts",
    "check:prod": "tsx ../../scripts/doctor.ts --prod",
    "doctor": "tsx ../../scripts/doctor.ts",
    "bootstrap:admin": "tsx scripts/bootstrapAdmin.ts",
    "seed:team": "tsx scripts/seedTeam.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@dcs-docs/shared": "*",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "prisma": "5.22.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
